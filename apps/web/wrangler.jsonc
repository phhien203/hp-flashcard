// The Flashcard Worker: the API at /api/*, and the built frontend (dist/)
// for every other path. See README.md for local setup and ADR 0001.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hp-flashcard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; assets are served without it.
    "run_worker_first": ["/api/*"],
  },
  // Local defaults deliberately have no production route or credentials.
  "workers_dev": false,
  "preview_urls": false,
  "version_metadata": { "binding": "WORKER_VERSION" },
  "env": {
    "production": {
      "name": "hp-flashcard",
      "account_id": "5f7f25968ee22b7e1719fb064620973b",
      "routes": [{ "pattern": "flashcard.hien.page", "custom_domain": true }],
      "vars": {
        "CLERK_AUTHORIZED_PARTIES": "https://flashcard.hien.page",
      },
      "version_metadata": { "binding": "WORKER_VERSION" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hp-flashcard",
          "database_id": "495f0334-6bd7-4847-9176-ca9332674b15",
          "migrations_dir": "migrations",
        },
      ],
      "secrets": {
        "required": ["CLERK_JWT_KEY", "CLERK_WEBHOOK_SIGNING_SECRET"],
      },
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hp-flashcard",
      // Local development and tests use a local database under .wrangler/.
      // This placeholder is no remote database. Production uses its explicit
      // account and database id in env.production above.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Daily: forget expired idempotency records, old webhook deliveries and
  // rate-limit entries out of their window.
  "triggers": { "crons": ["17 3 * * *"] },
  // Workers Logs and Issues (error monitoring), every request. The Worker
  // logs its own sanitized records (worker/log.ts): request id, route
  // pattern, status, latency, error class. Cloudflare's automatic
  // invocation logs and traces are off: they would record request URLs,
  // which name Cards, and details this app keeps out of its logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
