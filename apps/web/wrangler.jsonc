// The Flashcard Worker: the API at /api/*, and the built frontend (dist/)
// for every other path. See README.md for local setup and ADR 0001.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hp-flashcard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only the API reaches the Worker; assets are served without it.
    "run_worker_first": ["/api/*"],
  },
  // No public workers.dev or preview URLs (ADR 0001). Production routing,
  // the custom domain and deployment arrive with the deployment slice.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hp-flashcard",
      // Local development and tests use a local database under .wrangler/.
      // The production database's id is filled in when it is provisioned
      // (a human step: see README.md); this placeholder is no real database.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Daily: forget expired idempotency records, old webhook deliveries and
  // rate-limit entries out of their window.
  "triggers": { "crons": ["17 3 * * *"] },
  // Workers Logs and Issues (error monitoring), every request. The Worker
  // logs its own sanitized records (worker/log.ts): request id, route
  // pattern, status, latency, error class. Cloudflare's automatic
  // invocation logs and traces are off: they would record request URLs,
  // which name Cards, and details this app keeps out of its logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "issues": { "enabled": true },
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
