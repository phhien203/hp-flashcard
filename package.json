{
  "name": "hp-flashcard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @hp-flashcard/storybook dev",
    "storybook": "pnpm --filter @hp-flashcard/storybook dev",
    "build": "pnpm --filter @hp-flashcard/ui build",
    "build-storybook": "pnpm --filter @hp-flashcard/storybook build",
    "dev:web": "pnpm --filter @hp-flashcard/web dev",
    "dev:web:mock": "pnpm --filter @hp-flashcard/web dev:mock",
    "dev:api": "pnpm --filter @hp-flashcard/web dev:api",
    "build:web": "pnpm --filter @hp-flashcard/web build",
    "generate:api": "pnpm --filter @hp-flashcard/web generate:api",
    "check:api": "pnpm --filter @hp-flashcard/web check:api",
    "test": "node --test scripts/implement-spec.test.mjs && vitest run",
    "test:watch": "vitest",
    "test:all": "node --test scripts/implement-spec.test.mjs && VITEST_BROWSERS=chromium,firefox,webkit vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "check:package": "pnpm --filter @hp-flashcard/ui check:package",
    "changeset": "changeset",
    "release": "pnpm build && node scripts/stage-release.mjs",
    "prepare": "husky",
    "sandcastle": "tsx .sandcastle/main.ts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "globals": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,mdx,css,yml,yaml}": "prettier --write"
  }
}
