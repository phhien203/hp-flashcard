{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinAllExceptPeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "schedule": ["before 9am on monday"],
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "1 day",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on monday"]
  },
  "packageRules": [
    {
      "description": "Patch updates that pass CI merge themselves.",
      "matchUpdateTypes": ["patch", "pin", "digest"],
      "automerge": true
    },
    {
      "groupName": "storybook",
      "matchPackageNames": [
        "storybook",
        "@storybook/**",
        "eslint-plugin-storybook"
      ]
    },
    {
      "groupName": "vitest",
      "matchPackageNames": [
        "vitest",
        "@vitest/**",
        "vitest-browser-react",
        "playwright"
      ]
    },
    {
      "groupName": "tailwindcss",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/**",
        "prettier-plugin-tailwindcss"
      ]
    },
    {
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "eslint",
      "matchPackageNames": [
        "eslint",
        "@eslint/**",
        "typescript-eslint",
        "eslint-plugin-*",
        "eslint-config-*",
        "globals"
      ]
    },
    {
      "description": "The stack is deliberately on TypeScript 6; moving to 7 is a decision, not a bump.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "The stack is deliberately on Node 24 (.nvmrc, engines, @types/node); moving to 26 is a decision, not a bump.",
      "matchPackageNames": ["node", "@types/node"],
      "allowedVersions": "<25"
    }
  ]
}
